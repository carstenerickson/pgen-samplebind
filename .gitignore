# pgen-samplebind generated outputs (but allow committed test fixtures under tests/fixtures/tiny_aadr/)
*.pgen
*.pvar
*.psam
*.bed
*.bim
*.fam
*.geno
*.snp
*.ind
!tests/fixtures/tiny_aadr/*.pgen
!tests/fixtures/tiny_aadr/*.pvar
!tests/fixtures/tiny_aadr/*.psam
!tests/data/*.geno
!tests/data/*.snp
# Dogfood fixture — vendored AADR-derivative for regression test (see tests/dogfood/README.md)
!tests/dogfood/fixtures/*.geno
!tests/dogfood/fixtures/*.snp
!tests/dogfood/fixtures/*.ind

